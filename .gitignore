parameters/*.local.bicepparam

# Secrets — never commit
*.pw
*.secret
.env

# Bicep build output
*.json
!.github/**/*.json
!bicepconfig.json

# PSRule reports
reports/

# OS / editor
.DS_Store
.vscode/
*.swp
